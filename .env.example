# Meros — P0 environment template (placeholders only, no secrets)
# Copy to .env.local and fill in. Never commit real values.

# --- Walrus Memory (Mainnet relayer, server-only) ---
# Ed25519 delegate private key (hex or suiprivkey1...). Server-only.
MEMWAL_PRIVATE_KEY=
# Walrus Memory account object ID on Sui (0x...). Server-only.
MEMWAL_ACCOUNT_ID=
# Relayer URL. Default is Mainnet relayer if unset.
# Mainnet: https://relayer.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- Gemini (scaffold only in P0, server-only) ---
GEMINI_API_KEY=

# --- Neon Postgres (operational metadata only, NOT the memory store) ---
DATABASE_URL=

# --- Meros identity derivation ---
# Optional salt mixed into the access-code hash. Changing it remaps all namespaces.
MEROS_ID_SALT=meros-p0-v1

# --- Gemini models (server-only; IDs must come from a live models.list, never guessed) ---
# Primary default: gemini-3.5-flash-lite. Fallback default: gemini-3.7-flash.
GEMINI_MODEL=
# Fallback runs only on retryable/model-availability failures of the primary.
GEMINI_FALLBACK_MODEL=
